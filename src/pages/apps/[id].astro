---
import { getCollection, getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Telefono from '../../components/Telefono.astro';
import BotonPlay from '../../components/BotonPlay.astro';
import TarjetaApp from '../../components/TarjetaApp.astro';
import Icono from '../../components/Icono.astro';
import { redondear } from '../../data/sitio';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({ params: { id: app.id }, props: { app } }));
}

interface Props {
  app: CollectionEntry<'apps'>;
}
const { app } = Astro.props;
const d = app.data;
const { Content } = await render(app);
const politica = await getEntry('privacidad', app.id);
const otras = (await getCollection('apps')).filter((a) => a.id !== app.id).sort((a, b) => a.data.orden - b.data.orden);
const horizontales = d.videos.filter((v) => !v.vertical);
const verticales = d.videos.filter((v) => v.vertical);
const ruta = (archivo: string) => `/videos/${app.id}/${archivo}`;
const esWindows = d.plataforma === 'Windows';

// Datos estructurados para Google: la app y la ruta de migas (Inicio › Apps › App)
const url = (camino: string) => new URL(camino, Astro.site).href;
const datos = [
  {
    '@context': 'https://schema.org',
    '@type': esWindows ? 'SoftwareApplication' : 'MobileApplication',
    name: d.nombre,
    description: d.resumen,
    url: url(`/apps/${app.id}/`),
    image: url(d.destacado.src),
    operatingSystem: d.plataforma,
    applicationCategory: d.tipoSchema,
    inLanguage: 'es',
    author: { '@id': url('/#afesdev') },
    // Islita aún no tiene precio definido: no se le declara uno a Google
    ...(esWindows ? {} : { offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } }),
    ...(d.playUrl && d.estado === 'publicada' ? { installUrl: d.playUrl, downloadUrl: d.playUrl } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: url('/') },
      { '@type': 'ListItem', position: 2, name: 'Apps', item: url('/apps/') },
      { '@type': 'ListItem', position: 3, name: d.nombre, item: url(`/apps/${app.id}/`) },
    ],
  },
];
---

<Base tituloSeo={d.seo.titulo} descripcion={d.seo.descripcion} imagen={d.destacado} datos={datos}>
  <div style={`--app:${d.colores.principal};--app-osc:${d.colores.oscuro};--app-suave:${d.colores.suave}`}>
    <section class="hero">
      <div class="contenedor hero-fila">
        <div class="hero-texto">
          <a class="volver" href="/#apps">← Todas las apps</a>
          <div class="identidad">
            <Image class="icono" src={d.icono} alt={`Ícono de ${d.nombre}`} width={192} loading="eager" />
            <div>
              <h1>{d.nombre}</h1>
              <span class="categoria">{d.categoria}</span>
            </div>
          </div>
          <p class="eslogan">{d.eslogan}</p>
          <p class="resumen">{d.resumen}</p>
          {
            d.cifras && (
              <dl class="cifras">
                <div>
                  <dt>descargas</dt>
                  <dd>{redondear(d.cifras.descargas)}</dd>
                </div>
                <div>
                  <dt>países</dt>
                  <dd>{d.cifras.paises}</dd>
                </div>
              </dl>
            )
          }
          <BotonPlay app={app} />
        </div>
        {
          esWindows ? (
            <div class="hero-ventanas">
              <Image src={d.pantallas[0]} alt={`Pantalla de ${d.nombre}`} width={960} loading="eager" />
              <Image src={d.pantallas[1]} alt={`Otra pantalla de ${d.nombre}`} width={960} loading="eager" />
            </div>
          ) : (
            <div class="hero-visual">
              <div class="tel tel-0">
                <Telefono pantalla={d.pantallas[0]} alt={`Pantalla de ${d.nombre}`} ancho={250} carga="eager" />
              </div>
              <div class="tel tel-1">
                <Telefono pantalla={d.pantallas[1]} alt={`Otra pantalla de ${d.nombre}`} ancho={230} carga="eager" />
              </div>
            </div>
          )
        }
      </div>
    </section>

    <section class="seccion">
      <div class="contenedor">
        <span class="antetitulo">Funciones</span>
        <h2 class="titulo-seccion">Qué puedes hacer con {d.nombre}</h2>
        <div class="funciones">
          {
            d.funciones.map((f) => (
              <article class="funcion">
                <span class="check">
                  <Icono nombre="check" tam={20} />
                </span>
                <h3>{f.titulo}</h3>
                <p>{f.texto}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="seccion fondo-suave">
      <div class="contenedor">
        <span class="antetitulo">Capturas</span>
        <h2 class="titulo-seccion">Así se ve</h2>
        <p class="intro-seccion">Desliza para ver todas. Toca una para verla en grande.</p>
      </div>
      <div class="galeria" tabindex="0" aria-label={`Capturas de ${d.nombre}`}>
        {
          d.capturas.map((c) => (
            <a class:list={['captura', { 'captura-ancha': esWindows }]} href={c.src.src} target="_blank" rel="noopener">
              <Image src={c.src} alt={c.titulo} width={540} />
            </a>
          ))
        }
      </div>
    </section>

    {
      d.videos.length > 0 && (
        <section class="seccion">
          <div class="contenedor">
            <span class="antetitulo">Videos</span>
            <h2 class="titulo-seccion">Mírala en acción</h2>
            {horizontales.map((v) => (
              <figure class="video ancho">
                <video controls preload="none" playsinline poster={ruta(`${v.archivo}.jpg`)}>
                  <source src={ruta(`${v.archivo}.mp4`)} type="video/mp4" />
                </video>
                <figcaption>{v.titulo}</figcaption>
              </figure>
            ))}
            <div class="verticales">
              {verticales.map((v) => (
                <figure class="video">
                  <video controls preload="none" playsinline poster={ruta(`${v.archivo}.jpg`)}>
                    <source src={ruta(`${v.archivo}.mp4`)} type="video/mp4" />
                  </video>
                  <figcaption>{v.titulo}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="seccion fondo-blanco">
      <div class="contenedor sobre">
        <div class="texto">
          <span class="antetitulo">Sobre la app</span>
          <h2 class="titulo-seccion">La historia de {d.nombre}</h2>
          <div class="prosa"><Content /></div>
        </div>
        <aside class="ficha">
          <h3>Ficha</h3>
          <dl>
            <dt>Categoría</dt>
            <dd>{d.categoria}</dd>
            <dt>Plataforma</dt>
            <dd>{d.plataforma}</dd>
            <dt>Estado</dt>
            <dd>{esWindows ? 'En desarrollo, muy pronto' : d.estado === 'publicada' ? 'Publicada en Google Play' : 'En prueba, muy pronto'}</dd>
            <dt>Hecha con</dt>
            <dd class="chips">{d.tecnologias.map((t) => <span class="chip">{t}</span>)}</dd>
          </dl>
          <BotonPlay app={app} />
          {
            politica && (
              <a class="legal" href={`/apps/${app.id}/privacidad`}>
                Política de privacidad
              </a>
            )
          }
        </aside>
      </div>
    </section>

    {
      otras.length > 0 && (
        <section class="seccion">
          <div class="contenedor">
            <span class="antetitulo">Más apps</span>
            <h2 class="titulo-seccion">También te puede interesar</h2>
            <div class="otras">
              {otras.map((a) => <TarjetaApp app={a} />)}
            </div>
            <div class="cta">
              <p>¿Quieres una app como esta para tu idea o tu negocio?</p>
              <a class="boton boton-coral" href="/#contacto">Hablemos <Icono nombre="flecha" tam={20} /></a>
            </div>
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .hero {
    color: #fff;
    overflow: hidden;
    background:
      radial-gradient(700px 500px at 80% 20%, color-mix(in srgb, var(--app) 80%, #fff 20%) 0%, transparent 65%),
      linear-gradient(135deg, var(--app-osc), var(--app));
  }
  .hero-fila {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px;
    align-items: center;
    padding: calc(var(--alto-cabecera) + clamp(24px, 4vw, 48px)) 0 clamp(40px, 6vw, 72px);
  }
  .volver {
    display: inline-block;
    margin-bottom: 28px;
    font-weight: 700;
    text-decoration: none;
    opacity: 0.8;
  }
  .volver:hover {
    opacity: 1;
  }
  .identidad {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .identidad :global(.icono) {
    width: 88px;
    height: 88px;
    border-radius: 24px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
  }
  h1 {
    font-size: clamp(38px, 5.5vw, 60px);
    font-weight: 800;
  }
  .categoria {
    font-weight: 700;
    opacity: 0.8;
  }
  .eslogan {
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 800;
    margin: 28px 0 10px;
  }
  .resumen {
    font-size: 18px;
    opacity: 0.88;
    max-width: 540px;
    margin: 0 0 30px;
  }
  .cifras {
    display: flex;
    gap: 36px;
    margin: -8px 0 30px;
  }
  .cifras div {
    display: flex;
    flex-direction: column;
  }
  .cifras dd {
    order: -1;
    margin: 0;
    font-size: 32px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .cifras dt {
    font-weight: 700;
    opacity: 0.8;
  }
  .hero-visual {
    position: relative;
    height: 560px;
  }
  .tel {
    position: absolute;
  }
  .tel-0 {
    left: 4%;
    top: 20px;
    z-index: 1;
    transform: rotate(-5deg);
  }
  .tel-1 {
    right: 4%;
    top: 50px;
    transform: rotate(6deg);
  }
  .hero-ventanas {
    display: grid;
    gap: 18px;
  }
  .hero-ventanas :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
    box-shadow: 0 24px 50px rgba(5, 8, 15, 0.35);
  }
  @media (max-width: 900px) {
    .hero-fila {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      height: 440px;
      max-width: 440px;
      width: 100%;
      margin-inline: auto;
    }
    .hero-visual :global(.telefono) {
      --ancho: 195px !important;
    }
    .tel-0 { left: 0; }
    .tel-1 { right: 0; }
  }

  .antetitulo {
    color: var(--app);
  }

  .funciones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: 40px;
  }
  .funcion {
    padding: 26px;
    border-radius: var(--radio);
    background: var(--blanco);
    border: 1px solid var(--borde);
  }
  .check {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--app-suave);
    color: var(--app);
    margin-bottom: 16px;
  }
  .funcion h3 {
    font-size: 19px;
    font-weight: 800;
  }
  .funcion p {
    margin: 6px 0 0;
    color: var(--suave);
  }

  .fondo-suave {
    background: var(--app-suave);
  }
  .fondo-blanco {
    background: var(--blanco);
  }
  .galeria {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 36px max(16px, (100% - var(--ancho)) / 2) 20px;
    scroll-padding-inline: max(16px, (100% - var(--ancho)) / 2);
    scrollbar-width: thin;
    scrollbar-color: var(--app) transparent;
  }
  .captura {
    flex: 0 0 auto;
    width: clamp(200px, 22vw, 260px);
    scroll-snap-align: start;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(16, 24, 40, 0.16);
    transition: transform 0.2s;
  }
  .captura:hover {
    transform: translateY(-4px);
  }
  .captura-ancha {
    width: clamp(300px, 40vw, 500px);
  }

  .video {
    margin: 0;
  }
  .video video {
    width: 100%;
    border-radius: 20px;
    background: #000;
  }
  .video figcaption {
    margin-top: 10px;
    font-weight: 700;
    color: var(--suave);
  }
  .video.ancho {
    margin-top: 40px;
  }
  .video.ancho video {
    aspect-ratio: 16 / 9;
  }
  .verticales {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    margin-top: 32px;
  }
  .verticales video {
    aspect-ratio: 9 / 16;
  }

  .sobre {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .prosa {
    font-size: 18px;
    color: var(--suave);
    max-width: 640px;
  }
  .ficha {
    padding: 28px;
    border-radius: 24px;
    background: var(--fondo);
    border: 1px solid var(--borde);
  }
  .ficha h3 {
    font-size: 20px;
    font-weight: 800;
  }
  dl {
    margin: 16px 0 24px;
  }
  dt {
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--suave);
    margin-top: 14px;
  }
  dd {
    margin: 4px 0 0;
    font-weight: 700;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }
  .legal {
    display: block;
    margin-top: 18px;
    font-size: 15px;
    font-weight: 700;
    color: var(--suave);
  }
  .legal:hover {
    color: var(--app);
  }
  @media (max-width: 800px) {
    .sobre {
      grid-template-columns: 1fr;
    }
  }

  .otras {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 420px));
    gap: 28px;
    margin-top: 40px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 56px;
    padding: 28px 32px;
    border-radius: 24px;
    background: var(--noche);
    color: #fff;
  }
  .cta p {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
  }
</style>
