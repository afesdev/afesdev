---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Telefono from '../components/Telefono.astro';
import TarjetaApp from '../components/TarjetaApp.astro';
import Icono from '../components/Icono.astro';
import Redes from '../components/Redes.astro';
import { sitio, servicios, proceso, tecnologias, redondear } from '../data/sitio';

const apps = (await getCollection('apps')).sort((a, b) => a.data.orden - b.data.orden);
const moviles = apps.filter((a) => a.data.plataforma !== 'Windows');
const islita = apps.find((a) => a.id === 'islita');

// Cifras reales: salen de los .md de cada app (campo cifras)
const descargas = apps.reduce((suma, a) => suma + (a.data.cifras?.descargas ?? 0), 0);
const paises = Math.max(0, ...apps.map((a) => a.data.cifras?.paises ?? 0));
const cifras = [
  { valor: String(apps.length), etiqueta: 'Apps creadas' },
  { valor: String(apps.filter((a) => a.data.estado === 'publicada').length), etiqueta: 'Publicadas en Google Play' },
  { valor: redondear(descargas), etiqueta: 'Descargas' },
  { valor: String(paises), etiqueta: 'Países donde está disponible' },
];
---

<Base>
  <section class="hero">
    <div class="rejilla" aria-hidden="true"></div>
    <div class="contenedor hero-fila">
      <div class="hero-texto">
        <span class="antetitulo">Desarrollador de apps móviles</span>
        <h1>Creo apps reales, <em>de la idea a Google Play</em></h1>
        <p>
          Diseño, programo y publico apps móviles con Flutter y C#. Te acompaño desde la primera idea hasta el
          lanzamiento, incluido el contenido para darla a conocer.
        </p>
        <div class="acciones">
          <a class="boton boton-coral" href="#contacto">Cuéntame tu idea <Icono nombre="flecha" tam={20} /></a>
          <a class="boton boton-borde claro" href="#apps">Ver mis apps</a>
        </div>
        <ul class="datos">
          <li><strong>Flutter</strong> para Android y iOS</li>
          <li><strong>C# / .NET</strong> en el backend</li>
        </ul>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="codigo">
          <div class="puntos"><span></span><span></span><span></span></div>
          <div><span class="k">var</span> idea = <span class="s">"tu app"</span>;</div>
          <div><span class="k">var</span> app = <span class="f">Diseñar</span>(idea)</div>
          <div>&nbsp;&nbsp;.<span class="f">Programar</span>()</div>
          <div>&nbsp;&nbsp;.<span class="f">Probar</span>();</div>
          <div><span class="f">PublicarEnPlay</span>(app); <span class="c">// ✓</span></div>
        </div>
        {
          moviles.slice(0, 2).map((app, i) => (
            <div class={`tel tel-${i}`}>
              <Telefono pantalla={app.data.pantallas[0]} alt="" ancho={250} carga="eager" />
            </div>
          ))
        }
        {
          islita && (
            <div class="isla-grupo">
              <div class="isla">
                <Image src={islita.data.pantallas[0]} alt="" width={484} loading="eager" />
              </div>
              <Image class="isla-icono" src={islita.data.icono} alt="" width={144} loading="eager" />
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="cifras" aria-label="En números">
    <div class="contenedor">
      <dl class="cifras-fila">
        {
          cifras.map((c) => (
            <div class="cifra">
              <dt>{c.etiqueta}</dt>
              <dd>{c.valor}</dd>
            </div>
          ))
        }
      </dl>
      <p class="fuente">Datos de Google Play Console · {sitio.cifrasActualizadas}</p>
    </div>
  </section>

  <section class="seccion" id="apps">
    <div class="contenedor">
      <span class="antetitulo">Mis apps</span>
      <h2 class="titulo-seccion">Apps que diseñé, programé y publiqué</h2>
      <p class="intro-seccion">Cada una tiene su propia página con funciones, capturas y videos.</p>
      <div class="rejilla-apps">
        {apps.map((app) => <TarjetaApp app={app} />)}
      </div>
    </div>
  </section>

  <section class="seccion servicios" id="servicios">
    <div class="contenedor">
      <span class="antetitulo">Servicios</span>
      <h2 class="titulo-seccion">Lo que puedo hacer por tu proyecto</h2>
      <p class="intro-seccion">
        Desde una app sencilla para tu negocio hasta un producto completo con backend, publicado y listo para
        crecer.
      </p>
      <div class="rejilla-servicios">
        {
          servicios.map((s) => (
            <article class="servicio">
              <span class="servicio-icono">
                <Icono nombre={s.icono} />
              </span>
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seccion proceso">
    <div class="contenedor">
      <span class="antetitulo">Cómo trabajo</span>
      <h2 class="titulo-seccion">Cuatro pasos, sin enredos</h2>
      <ol class="pasos">
        {
          proceso.map((p, i) => (
            <li>
              <span class="numero">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="seccion sobre" id="sobre-mi">
    <div class="contenedor sobre-fila">
      <div>
        <span class="antetitulo">Sobre mí</span>
        <h2 class="titulo-seccion">Hola, soy {sitio.nombre}</h2>
        <p class="intro-seccion">
          Soy desarrollador de apps. Me gusta llevar una idea hasta el final: diseñarla, programarla, publicarla en
          la tienda y contarle al mundo que existe.
        </p>
        <p class="intro-seccion">
          En mi canal de YouTube <strong>aedeveloper</strong> muestro cómo construyo mis apps, paso a paso.
        </p>
        <a class="boton boton-borde" href={sitio.redes.youtube} target="_blank" rel="noopener">
          <Icono nombre="youtube" /> Ver mi canal
        </a>
      </div>
      <div class="tecnologias">
        <h3>Con qué trabajo</h3>
        <div class="chips">
          {tecnologias.map((t) => <span class="chip">{t}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="seccion contacto" id="contacto">
    <div class="contenedor caja-contacto">
      <h2 class="titulo-seccion">¿Tienes una idea para una app?</h2>
      <p>Cuéntame qué quieres construir y te respondo con una propuesta y un estimado.</p>
      <div class="acciones">
        <a class="boton boton-coral" href={`mailto:${sitio.correo}?subject=Quiero%20una%20app`}>
          <Icono nombre="correo" />
          {sitio.correo}
        </a>
      </div>
      <p class="siguenos">O sígueme en redes</p>
      <div class="redes-contacto"><Redes /></div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(700px 420px at 75% 40%, rgba(255, 107, 74, 0.16), transparent 70%),
      radial-gradient(900px 600px at 100% 0%, #24305a 0%, transparent 60%),
      var(--noche);
  }
  .rejilla {
    position: absolute;
    inset: 0;
    opacity: 0.06;
    background-image:
      linear-gradient(#fff 1px, transparent 1px),
      linear-gradient(90deg, #fff 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(900px 500px at 60% 50%, #000 30%, transparent 75%);
  }
  .hero-fila {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 40px;
    align-items: center;
    padding: calc(var(--alto-cabecera) + clamp(40px, 6vw, 72px)) 0 calc(48px + clamp(40px, 6vw, 72px));
  }
  .hero .antetitulo {
    color: var(--coral);
  }
  h1 {
    font-size: clamp(40px, 6vw, 68px);
    font-weight: 800;
    letter-spacing: -0.035em;
  }
  h1 em {
    font-style: normal;
    color: var(--coral);
  }
  .hero-texto > p {
    font-size: 19px;
    color: #c9d1e3;
    max-width: 540px;
    margin: 22px 0 0;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }
  .claro {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }
  .datos {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    list-style: none;
    padding: 0;
    margin: 40px 0 0;
    color: #9aa6c2;
    font-size: 15px;
  }
  .datos strong {
    color: #fff;
  }

  .hero-visual {
    position: relative;
    height: 560px;
  }
  .tel {
    position: absolute;
  }
  .tel-0 {
    left: 6%;
    top: 30px;
    transform: rotate(-6deg);
  }
  .tel-1 {
    left: 44%;
    top: 0;
    transform: rotate(5deg);
  }
  /* La captura trae el fondo de pantalla a los lados: se recorta para que solo quede la isla. */
  .isla-grupo {
    position: absolute;
    z-index: 3;
    right: -3%;
    bottom: 44px;
    width: 300px;
    transform: rotate(3deg);
  }
  .isla {
    aspect-ratio: 400 / 174;
    overflow: hidden;
    border-radius: 34px;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.45);
  }
  .isla-grupo :global(.isla-icono) {
    position: absolute;
    top: -52px;
    left: -30px;
    width: 72px;
    height: 72px;
    border-radius: 20px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
    transform: rotate(-9deg);
  }
  .isla :global(img) {
    display: block;
    width: 121%;
    max-width: none;
    height: auto;
    margin-left: -9.5%;
  }
  .codigo {
    position: absolute;
    z-index: 2;
    left: -4%;
    bottom: 10px;
    padding: 16px 22px 18px;
    border-radius: 18px;
    background: rgba(11, 17, 32, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.35);
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.7;
    color: #e8ecf5;
    transform: rotate(-3deg);
  }
  .puntos {
    display: flex;
    gap: 6px;
    margin-bottom: 8px;
  }
  .puntos span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3a4566;
  }
  .k { color: #ff8c70; }
  .f { color: #7fd1ae; }
  .s { color: #f0c674; }
  .c { color: #5c6a8c; }

  @media (max-width: 900px) {
    .hero-fila {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      height: 470px;
      max-width: 460px;
      width: 100%;
      margin-inline: auto;
    }
    .hero-visual :global(.telefono) {
      --ancho: 210px !important;
    }
    .tel-0 { left: 0; }
    .tel-1 { left: auto; right: 0; }
    .codigo { left: 0; font-size: 12px; }
    .isla-grupo { right: 0; bottom: 120px; width: 230px; }
    .isla { border-radius: 26px; }
    .isla-grupo :global(.isla-icono) { top: -42px; left: -14px; width: 56px; height: 56px; border-radius: 16px; }
  }

  /* Franja de cifras: se monta sobre el borde inferior del hero */
  .cifras {
    position: relative;
    z-index: 2;
    margin-top: -48px;
  }
  .cifras-fila {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    border-radius: 24px;
    background: var(--blanco);
    border: 1px solid var(--borde);
    box-shadow: 0 20px 50px rgba(16, 24, 40, 0.1);
  }
  .cifra {
    display: flex;
    flex-direction: column;
    padding: 26px 28px;
  }
  .cifra dd {
    order: -1;
  }
  .cifra + .cifra {
    border-left: 1px solid var(--borde);
  }
  .cifra dd {
    margin: 0;
    font-size: clamp(34px, 4vw, 46px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--noche);
  }
  .cifra dt {
    margin-top: 8px;
    color: var(--suave);
    font-weight: 700;
    font-size: 15px;
  }
  .fuente {
    margin: 12px 4px 0;
    font-size: 13px;
    color: var(--suave);
    text-align: right;
  }
  @media (max-width: 760px) {
    .cifras-fila {
      grid-template-columns: repeat(2, 1fr);
    }
    .cifra:nth-child(3) {
      border-left: 0;
    }
    .cifra:nth-child(n + 3) {
      border-top: 1px solid var(--borde);
    }
    .cifra {
      padding: 20px;
    }
  }

  .rejilla-apps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px;
    margin-top: 44px;
  }

  .servicios {
    background: var(--blanco);
  }
  .rejilla-servicios {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 44px;
  }
  .servicio {
    padding: 28px;
    border-radius: var(--radio);
    background: var(--fondo);
    border: 1px solid var(--borde);
  }
  .servicio-icono {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--noche);
    color: var(--coral);
    margin-bottom: 18px;
  }
  .servicio h3 {
    font-size: 20px;
    font-weight: 800;
  }
  .servicio p {
    margin: 8px 0 0;
    color: var(--suave);
  }

  .pasos {
    list-style: none;
    padding: 0;
    margin: 44px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }
  .pasos li {
    padding-top: 22px;
    border-top: 3px solid var(--noche);
  }
  .numero {
    font-family: var(--mono);
    color: var(--coral-osc);
    font-weight: 500;
  }
  .pasos h3 {
    font-size: 22px;
    font-weight: 800;
    margin-top: 6px;
  }
  .pasos p {
    margin: 8px 0 0;
    color: var(--suave);
  }

  .sobre {
    background: var(--blanco);
  }
  .sobre-fila {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .sobre .boton {
    margin-top: 28px;
  }
  .tecnologias {
    padding: 32px;
    border-radius: 28px;
    background: var(--noche);
    color: #fff;
  }
  .tecnologias h3 {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 18px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .tecnologias .chip {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.14);
  }
  @media (max-width: 800px) {
    .sobre-fila {
      grid-template-columns: 1fr;
    }
  }

  .caja-contacto {
    padding: clamp(40px, 6vw, 72px);
    border-radius: 32px;
    text-align: center;
    color: #fff;
    background:
      radial-gradient(600px 300px at 50% 0%, rgba(255, 107, 74, 0.25), transparent 70%),
      var(--noche);
  }
  .caja-contacto .titulo-seccion {
    margin-inline: auto;
  }
  .caja-contacto p {
    color: #c9d1e3;
    font-size: 18px;
    margin: 16px auto 0;
  }
  .caja-contacto .acciones {
    justify-content: center;
  }
  .caja-contacto .boton {
    overflow-wrap: anywhere;
  }
  .caja-contacto .siguenos {
    margin-top: 32px;
    font-size: 15px;
    font-weight: 700;
  }
  .redes-contacto {
    display: flex;
    justify-content: center;
    margin-top: 14px;
  }
</style>
