---
// Botón de Google Play, o "Muy pronto" si la app sigue en prueba
import type { CollectionEntry } from 'astro:content';
import Icono from './Icono.astro';
interface Props {
  app: CollectionEntry<'apps'>;
}
const { estado, playUrl, plataforma } = Astro.props.app.data;
---

{
  plataforma === 'Windows' ? (
    <span class="play pronto">
      <Icono nombre="reloj" tam={22} />
      <span>
        <small>Muy pronto para</small>
        Windows
      </span>
    </span>
  ) : estado === 'publicada' && playUrl ? (
    <a class="play" href={playUrl} target="_blank" rel="noopener">
      <Icono nombre="play" tam={22} />
      <span>
        <small>Disponible en</small>
        Google Play
      </span>
    </a>
  ) : (
    <span class="play pronto">
      <Icono nombre="reloj" tam={22} />
      <span>
        <small>Muy pronto en</small>
        Google Play
      </span>
    </span>
  )
}

<style>
  .play {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 22px 10px 18px;
    border-radius: 14px;
    background: #05080f;
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    font-size: 18px;
    line-height: 1.1;
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: transform 0.15s;
  }
  a.play:hover {
    transform: translateY(-2px);
  }
  .play small {
    display: block;
    font-size: 11px;
    font-weight: 600;
    opacity: 0.75;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .pronto {
    background: rgba(255, 255, 255, 0.12);
  }
</style>
