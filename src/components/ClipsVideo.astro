---
// Grabaciones cortas y sin audio de una app de escritorio. Se reproducen solas mientras se ven.
interface Props {
  app: string;
  videos: { archivo: string; titulo: string }[];
}
const { app, videos } = Astro.props;
const ruta = (archivo: string) => `/videos/${app}/${archivo}`;
---

<div class="clips">
  {
    videos.map((v) => (
      <figure>
        <video data-clip muted loop playsinline preload="none" poster={ruta(`${v.archivo}.jpg`)} aria-label={v.titulo}>
          <source src={ruta(`${v.archivo}.mp4`)} type="video/mp4" />
        </video>
        <figcaption>{v.titulo}</figcaption>
      </figure>
    ))
  }
</div>

<script>
  const clips = document.querySelectorAll<HTMLVideoElement>('[data-clip]');

  // Con las animaciones desactivadas en el sistema, cada quien decide si los reproduce.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    clips.forEach((clip) => (clip.controls = true));
  } else {
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          const clip = entrada.target as HTMLVideoElement;
          if (entrada.isIntersecting) {
            clip.play().catch(() => {
              clip.controls = true;
            });
          } else {
            clip.pause();
          }
        }
      },
      { threshold: 0.4 },
    );
    clips.forEach((clip) => observador.observe(clip));
  }
</script>

<style>
  .clips {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 24px;
    margin-top: 40px;
  }
  figure {
    margin: 0;
  }
  video {
    display: block;
    width: 100%;
    aspect-ratio: 512 / 208;
    border-radius: 18px;
    background: #05080f;
    box-shadow: 0 16px 36px rgba(16, 24, 40, 0.14);
  }
  figcaption {
    margin-top: 10px;
    font-weight: 700;
    color: var(--suave);
  }
</style>
