---
// Marco de celular con una pantalla de la app
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  pantalla: ImageMetadata;
  alt: string;
  ancho?: number;
  carga?: 'eager' | 'lazy';
}
const { pantalla, alt, ancho = 260, carga = 'lazy' } = Astro.props;
---

<div class="telefono" style={`--ancho:${ancho}px`}>
  <div class="pantalla">
    <Image src={pantalla} alt={alt} width={ancho * 2} loading={carga} />
  </div>
</div>

<style>
  .telefono {
    width: var(--ancho);
    aspect-ratio: 9 / 19.2;
    padding: calc(var(--ancho) * 0.035);
    border-radius: calc(var(--ancho) * 0.15);
    background: #05080f;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1),
      0 30px 60px rgba(5, 8, 15, 0.35);
  }
  .pantalla {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--ancho) * 0.12);
    background: #f8f9fa;
  }
  .pantalla :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>
