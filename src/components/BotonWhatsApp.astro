---
// Botón flotante de WhatsApp (abajo a la derecha). Se configura en src/data/sitio.ts
import { sitio } from '../data/sitio';
const { numero, mensaje } = sitio.whatsapp;
const enlace = `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`;
---

{
  numero && (
    <a class="whatsapp" href={enlace} target="_blank" rel="noopener" aria-label="Escríbeme por WhatsApp">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
        <path
          transform="translate(7.2 7.2) scale(.4)"
          fill="currentColor"
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
        />
      </svg>
      <span class="globo">¿Hablamos?</span>
    </a>
  )
}

<style>
  .whatsapp {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 10px 28px rgba(37, 211, 102, 0.45);
    transition: transform 0.2s;
    animation: aparecer 0.4s ease 0.6s both;
  }
  .whatsapp:hover {
    transform: scale(1.08);
  }
  /* Onda que llama la atención un par de veces al cargar */
  .whatsapp::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25d366;
    z-index: -1;
    animation: onda 2s ease-out 1.2s 2;
  }
  .globo {
    position: absolute;
    right: 72px;
    padding: 8px 14px;
    border-radius: 12px;
    background: var(--noche);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 8px 24px rgba(16, 24, 40, 0.25);
    opacity: 0;
    transform: translateX(6px);
    transition:
      opacity 0.2s,
      transform 0.2s;
    pointer-events: none;
  }
  .whatsapp:hover .globo,
  .whatsapp:focus-visible .globo {
    opacity: 1;
    transform: none;
  }
  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.8);
    }
  }
  @keyframes onda {
    to {
      transform: scale(1.7);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .whatsapp,
    .whatsapp::before {
      animation: none;
    }
  }
</style>
